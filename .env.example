# Existing Proto2 capture/extraction
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Structured extraction and direct target-evolution calls
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSESSMENT_EVOLUTION_MODEL=openai/gpt-4.1-mini
ASSESSMENT_MODEL_TIMEOUT=120
ASSESSMENT_MODEL_RETRIES=2
ASSESSMENT_MODEL_TEMPERATURE=0.1
ASSESSMENT_MODEL_MAX_TOKENS=8192

# Self-hosted Langfuse v4. Raw learner solutions and secrets are never exported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=proto2-local

# SkillOpt model backends. Set the variables required by the backend selected
# in configs/assessment_improver/default.yaml.
OPENAI_API_KEY=
OPENAI_BASE_URL=
