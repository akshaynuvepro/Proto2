      "name": "Phase 2 Application Development",
      "objective": "",
      "tasks": [
        "Validate `GET /shipment/{trackingId}`, `POST /shipment/events`, and `GET /shipment/delayed` with request validation and structured error handling. **(Marks = 15)**",
        "Validate stream-processor parsing of Kinesis and SQS batches, with per-record failure isolation routed to the DLQ without failing the whole batch. **(Marks = 10)**"
      ]
    },
    {
      "name": "Phase 3 Deployment & Integration",
      "objective": "",
      "tasks": [
        "Validate Docker image build (`--platform linux/amd64 --provenance=false --sbom=false`) and push to the Amazon ECR repository. **(Marks = 10)**",
        "Validate `shipment-api-handler` Lambda deployment: container image, `shipment-lambda-role`, `ApiHandler::handleRequest` command override, 1024 MB memory, 30-second timeout. **(Marks = 10)**",
        "Validate `shipment-stream-processor` Lambda deployment: container image, `shipment-lambda-role`, `StreamProcessorHandler::handleRequest` command override, 1024 MB memory, 60-second timeout. **(Marks =",
        "Validate Kinesis trigger configuration on `shipment-stream-processor`: batch size 100, batch window 5 seconds, retry attempts 3, split batch on error enabled, on-failure destination set to `shipment-d",
        "Validate SQS trigger configuration on `shipment-stream-processor`: batch size 10. **(Marks = 5)**",
        "Validate API Gateway Lambda proxy integration to `shipment-api-handler` on both `/{proxy+}` and `/` (ANY), redeployed to the `prod` stage. **(Marks = 5)**"
      ]
    },
    {
      "name": "Phase 4 Observability",
      "objective": "",
      "tasks": [
        "Validate AWS X-Ray active tracing enabled on both Lambda functions (`shipment-api-handler`, `shipment-stream-processor`) and on the API Gateway `prod` stage. **(Marks = 5)**"
      ]
    },
    {
      "name": "Phase 5 End-to-End Validation",
      "objective": "",
      "tasks": [
        "Validate end-to-end API → DynamoDB flow (`POST /shipment/events` followed by `GET /shipment/{trackingId}`). **(Marks = 5)**",
        "Validate end-to-end Kinesis → DynamoDB / SNS / Firehose → S3 flow. **(Marks = 5)**",
        "Validate end-to-end SQS → DynamoDB flow. **(Marks = 5)**",
        "Validate Dead Letter Queue routing on an induced (malformed/repeatedly failing) event. **(Marks = 5)**"
      ]
    }
