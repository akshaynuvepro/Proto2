{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Skill Lab (Chainlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "chainlit",
      "args": ["run", "app.py", "--port", "8000"],
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Skill Lab (Chainlit, port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "chainlit",
      "args": ["run", "app.py", "--port", "8001"],
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
